{
  "name": "practicas-matematica",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma interactiva de prácticas de Álgebra con teoría en LaTeX y resolución paso a paso",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
